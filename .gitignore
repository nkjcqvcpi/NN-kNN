# Keep reproducible RL metrics and run metadata in Git, but never publish model
# weights or local launch artifacts.
#
# Results are filed by the host that produced them (2026-09-08 reorganisation):
#   results/r760/   Linux / H100 / CUDA
#   results/g234/   Windows Server 2025 / i5-13400F / Intel Arc, CPU
# One rule per host tree covers every battery underneath, so a new battery
# directory needs no new ignore rule.
/results/r760/**/*.pt
/results/r760/**/*.pth
/results/g234/**/*.pt
/results/g234/**/*.pth
# results/rl/ is the pre-reorganisation location and the runners' default
# --output-dir; keep the same policy in case a run lands there unfiled.
/results/rl/**/*.pt
/results/rl/**/*.pth

# Console logs and PID files: the structured files in each run directory are the
# canonical record. Collected under logs/<host>/ by the same reorganisation.
/logs/
/*.log
/*.err
/*pid*.txt
