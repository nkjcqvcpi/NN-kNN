# Keep reproducible RL metrics and run metadata in Git, but never publish model
# weights or local launch artifacts.
/results/rl/**/*.pt
/results/rl/**/*.pth
/*.log
/*pid*.txt

# The p17 CPU capacity replication writes outside results/rl/, so the
# /results/rl/**/*.pt rule above does not cover it. Same policy: keep the
# structured record, never publish model weights.
/results/rl_capacity_cpu_g234/**/*.pt
/results/rl_capacity_cpu_g234/**/*.pth
/*.err

# p20 ALE arms write outside results/rl/ too; same no-weights policy.
/results/rl_ale_g234/**/*.pt
/results/rl_ale_g234/**/*.pth
