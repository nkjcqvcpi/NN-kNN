# Results, logs and generated report files are not in git. They stay on the experiment
# host and will move to the shared NN-KNN/runs/ directory with TensorBoard logging.
/results/
/logs/
/reports/figures/
/reports/*.csv
/reports/*.json
/reports/*.txt
/reports/*.png
