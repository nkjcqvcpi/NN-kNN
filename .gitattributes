# Manage experiment results with Git LFS
results/** filter=lfs diff=lfs merge=lfs -text
results/**/*.json text !filter !diff !merge
results/**/*.md text !filter !diff !merge
results/**/*.py text !filter !diff !merge
results/**/*.csv text !filter !diff !merge

# Model checkpoints & large binary weights
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
results/**/*.jsonl text !filter !diff !merge

# Evidence copied from the Codex task workspace: store bytes exactly as produced,
# because its verification files record hashes of the originals.
results/t3/*/codex_task_*/** -text
logs/t3/*/codex_task_*/** -text
